# TXT Reader Multi 환경 변수 예시
# 필요한 값만 수정하십시오. 숫자 단위는 이름에 표시된 대로 bytes 또는 ms입니다.

# 계정과 세션
# Owner 비밀번호 허용 하한은 10자이며 운영 권장은 14자 이상입니다.
LOGINID=owner_admin
LOGINPW=change_this_to_14_chars_or_more
OWNER_PASSWORD_MIN_LENGTH=14
USER_PASSWORD_MIN_LENGTH=8
SESSION_STORE_SECRET=change_this_to_a_long_random_secret_32_chars_or_more

# 서버
# 상태 확인 주소는 /healthz입니다. 외부 공개가 필요 없으면 127.0.0.1로 제한합니다.
NODE_ENV=
PORT=3000
HOST=
TXT_READER_BIND_ADDRESS=0.0.0.0
TXT_READER_DATA_DIR=/app/data
SHUTDOWN_HTTP_DRAIN_MS=10000
SHUTDOWN_GRACE_MS=45000

# 접속 주소와 프록시
# direct, trusted-proxy, cloudflare-tunnel 중 하나를 사용합니다. 프록시 배포에서는 원본 서버의 WAN 직접 접근을 반드시 차단합니다.
DEPLOYMENT_MODE=direct
URL=http://localhost:3000
APP_ORIGIN=http://localhost:3000
REQUIRE_STRICT_ORIGIN=1
TRUST_PROXY=
CLIENT_IP_HEADER=
# 실제 reverse proxy/Tunnel의 socket peer CIDR만 지정합니다. public client 대역을 넣지 않습니다.
TRUSTED_PROXY_CIDRS=127.0.0.0/8,::1/128,172.16.0.0/12
# Cloudflare Web Analytics/Browser Insights 자동 주입을 사용할 때만 1로 설정합니다.
# 사용하지 않으면 Cloudflare 대시보드에서 주입을 끄고 0을 유지합니다.
ALLOW_CLOUDFLARE_INSIGHTS=0
# blob: Worker가 꼭 필요한 사용자 기능을 허용할 때만 1로 설정합니다.
ALLOW_BLOB_WORKER=0

# 라이브러리
# 이름 변경·이동·삭제를 사용하려면 LIBRARY_MOUNT_MODE를 rw로 설정합니다.
LIBRARY_PATH=/absolute/path/to/novels
LIBRARY_MOUNT_MODE=ro
LIBRARY_DEEP_SIGNATURE_CHECK_TTL_MS=30000
LIBRARY_DEEP_SIGNATURE_CHECK_MAX_TTL_MS=300000
LIBRARY_SIGNATURE_CHECK_CONCURRENCY=8
LIBRARY_REQUEST_COLD_WAIT_MS=4000
LIBRARY_CATALOG_CACHE_COMPRESSION_LEVEL=6
LIBRARY_CATALOG_CACHE_WRITE_DELAY_MS=5000
LIBRARY_COLD_FAILURE_BACKOFF_BASE_MS=5000
LIBRARY_COLD_FAILURE_BACKOFF_MAX_MS=120000
LIBRARY_SHELF_BUILD_CONCURRENCY=1
LIBRARY_SHELF_BUILD_MAX_PENDING=8

# 파일 변경 요청
# 대기열이 가득 차거나 대기 시간이 초과되면 서버가 503과 Retry-After를 반환합니다.
FILEOPS_MUTATION_QUEUE_MAX=64
FILEOPS_MUTATION_WAIT_TIMEOUT_MS=30000
FILEOPS_MUTATION_WATCHDOG_MS=120000

# 중복·판본 fingerprint
LIBRARY_FINGERPRINT_CONCURRENCY=1
LIBRARY_FINGERPRINT_QUEUE_MAX=512
LIBRARY_FINGERPRINT_BACKGROUND_BATCH=64
LIBRARY_FINGERPRINT_ENTRY_DELAY_MS=15000
LIBRARY_FINGERPRINT_SAMPLE_BYTES=131072
LIBRARY_FINGERPRINT_SAMPLE_CHARS=16000
LIBRARY_FINGERPRINT_MAX_ENTRIES=100000
LIBRARY_FINGERPRINT_FRESHNESS_MS=600000
LIBRARY_FINGERPRINT_COMPRESSION_LEVEL=6

# 본문 처리와 캐시
MAX_TEXT_FILE_BYTES=104857600
CONTENT_FILE_CACHE_MAX_BYTES=134217728
CONTENT_FILE_CACHE_MAX_ENTRIES=16
CONTENT_DISK_CACHE_MIN_BYTES=1048576
CONTENT_WORKER_THREADS_ENABLED=1
CONTENT_WORKER_POOL_SIZE=0
CONTENT_WORKER_QUEUE_MAX=8
CONTENT_WORKER_IDLE_TTL_MS=30000
CONTENT_MAIN_THREAD_FALLBACK_MAX_BYTES=8388608
FOLDER_BLOCK_MANIFEST_RADIUS=5

# 텍스트 인코딩
# auto를 권장합니다. 강제 지정 예: utf8, cp949, euc-kr, shift_jis, gb18030.
TEXT_FILE_ENCODING=auto
TEXT_FILE_ENCODING_CANDIDATES=
TEXT_FILE_CHARDET_MIN_CONFIDENCE=0.6

# 검색 성능
# auto는 서버 코어와 저장장치 상태에 맞춰 보수적인 값을 선택합니다.
SEARCH_PERFORMANCE_PROFILE=auto
SEARCH_STORAGE_PROFILE=auto
SEARCH_SERVER_CORES=0
SEARCH_FULL_CONCURRENCY_MAX=0
SEARCH_LIVE_CONCURRENCY_MAX=0
SEARCH_MULTI_EPISODE_CONCURRENCY_MAX=0
SEARCH_CACHE_ONLY_CONCURRENCY=0
SEARCH_WORKER_BATCH_MAX=0

# 런타임 캐시 정리
DISK_CACHE_AUTO_PRUNE_ENABLED=1
DISK_CACHE_PRUNE_USAGE_PCT=85
DISK_CACHE_PRUNE_TARGET_USAGE_PCT=80
DISK_CACHE_PRUNE_MIN_FREE_MB=2048
DISK_CACHE_PRUNE_TARGET_FREE_MB=4096
DISK_CACHE_PRUNE_INTERVAL_MS=300000
DISK_CACHE_PRUNE_MIN_FILE_AGE_MS=60000
DISK_CACHE_PRUNE_MAX_DELETE_PER_RUN=5000

# 웹 메타데이터
METADATA_FETCH_ENABLED=1
METADATA_MAX_CANDIDATES=20000
METADATA_MAX_CANDIDATES_PER_WORK=30
METADATA_MAX_CANDIDATE_RESIDENT_BYTES=50331648
METADATA_STORE_COMPRESSION_LEVEL=6
METADATA_QUEUE_CONCURRENCY=1
METADATA_QUEUE_MAX=2000
METADATA_AUTO_APPLY_THRESHOLD=0.95
# 같은 공급자의 한 작품 수집이 끝난 뒤 다음 작품 수집까지의 기준 쿨타임.
# 실제 쿨타임은 이 값의 1.5~2.0배 범위에서 무작위로 적용된다.
METADATA_REQUEST_INTERVAL_MS=3000
METADATA_REQUEST_TIMEOUT_MS=10000
METADATA_RESPONSE_MAX_BYTES=2097152

# Playwright 로그인 프로필
METADATA_PLAYWRIGHT_ENABLED=1
METADATA_PLAYWRIGHT_HEADLESS=1
METADATA_PLAYWRIGHT_NO_SANDBOX=0
METADATA_PLAYWRIGHT_EXECUTABLE_PATH=
METADATA_PLAYWRIGHT_TIMEOUT_MS=30000
METADATA_PLAYWRIGHT_SETTLE_MS=900
# 수집용 Chromium context를 마지막 요청 후 유지하는 시간. 짧을수록 유휴 CPU/RSS가 빨리 회수됩니다.
METADATA_PLAYWRIGHT_COLLECTOR_IDLE_TTL_MS=90000

# 표지 저장소
# 수집된 표지는 content-addressed로 저장되고 API의 coverUrlLocal로 제공됩니다.
METADATA_COVER_MAX_BYTES=5242880
METADATA_COVER_CACHE_MAX_BYTES=2147483648
METADATA_COVER_ORPHAN_MIN_AGE_MS=604800000
METADATA_COVER_PRUNE_INTERVAL_MS=21600000
METADATA_COVER_PRUNE_MAX_DELETE_PER_RUN=200

# Cloudflare Tunnel compose를 사용할 때만 설정합니다.
CLOUDFLARE_TUNNEL_TOKEN=
