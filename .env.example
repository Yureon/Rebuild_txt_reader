# TxT Reader Multi environment example
# 기준: rebuild-v564
# 이 파일을 .env로 복사한 뒤 실제 값으로 바꾸세요.

# -----------------------------------------------------------------------------
# 1) owner 계정
# -----------------------------------------------------------------------------
# .env LOGINID / LOGINPW는 독서용 일반 계정이 아니라 owner 콘솔 전용 계정입니다.
# owner 로그인 후 기본 이동 대상은 /admin/users.html 입니다.
# NODE_ENV=production에서는 LOGINPW가 공백 제거 기준 OWNER_PASSWORD_MIN_LENGTH 이상이어야 합니다.
# 기본값은 14, 허용 하한은 10입니다. 운영에서는 14~16자 이상 passphrase를 권장합니다.
LOGINID=owner_admin
LOGINPW=change_this_to_14_chars_or_more
OWNER_PASSWORD_MIN_LENGTH=14

# 일반 user 비밀번호 최소 길이입니다. 기본값은 8이며 설정값도 8 이상으로 보정됩니다.
USER_PASSWORD_MIN_LENGTH=8

# -----------------------------------------------------------------------------
# 2) 런타임 / 쿠키 정책
# -----------------------------------------------------------------------------
# development 또는 빈 값: 로컬/내부망 HTTP 테스트 호환. 기존 session_token 쿠키 사용.
# production: HTTPS 전제. __Host-session_token + Secure + HttpOnly + SameSite=Strict 사용.
# production + HTTP 접속이면 브라우저가 Secure cookie를 저장하지 않아 로그인 유지가 불가능합니다.
# v391 이후 이 경우 /api/login은 production_https_required 진단 오류를 반환합니다.
# NODE_ENV=production

# 앱 포트입니다. Docker Compose 내부 앱 포트는 보통 3000입니다.
PORT=3000

# -----------------------------------------------------------------------------
# 3) Origin / URL
# -----------------------------------------------------------------------------
# URL과 APP_ORIGIN은 모두 허용 origin 후보로 병합됩니다.
# path(/login.html)가 아니라 origin(프로토콜 + 호스트 + 포트)만 입력하세요.
# 내부망과 외부망을 동시에 허용하려면 쉼표로 구분합니다.
URL=http://localhost:3000
APP_ORIGIN=http://localhost:3000

# unsafe method(POST/PUT/PATCH/DELETE)에 Origin/Referer 또는 same-origin/same-site Fetch Metadata를 요구합니다.
# production strict origin 모드에서는 APP_ORIGIN 또는 URL 미설정 시 Host fallback을 쓰지 않고 unsafe API를 차단합니다.
REQUIRE_STRICT_ORIGIN=1

# CSP 예외입니다. 실제로 Cloudflare Insights 또는 blob worker가 필요할 때만 1로 켜세요.
ALLOW_CLOUDFLARE_INSIGHTS=0
ALLOW_BLOB_WORKER=0

# -----------------------------------------------------------------------------
# 4) 라이브러리 경로 / 캐시
# -----------------------------------------------------------------------------
# 호스트의 TXT 라이브러리 절대 경로입니다.
# Windows 예: C:\novels
# macOS 예: /Volumes/MyDrive/novels
# Linux 예: /media/username/MyDrive/novels
LIBRARY_PATH=/absolute/path/to/novels

# 라이브러리 캐시 심층 디렉터리 signature 재검사 간격(ms)입니다.
LIBRARY_DEEP_SIGNATURE_CHECK_TTL_MS=2000

# 런타임 캐시 자동 정리 설정입니다. 계정/세션/사용자 데이터/폰트/감사 로그/라이브러리 TXT는 삭제하지 않고,
# data/chunk_indexes, data/content_chunks, data/block_manifests 캐시 파일만 오래된 항목부터 삭제합니다.
DISK_CACHE_AUTO_PRUNE_ENABLED=1
DISK_CACHE_PRUNE_USAGE_PCT=85
DISK_CACHE_PRUNE_TARGET_USAGE_PCT=80
DISK_CACHE_PRUNE_MIN_FREE_MB=2048
DISK_CACHE_PRUNE_TARGET_FREE_MB=4096
DISK_CACHE_PRUNE_INTERVAL_MS=300000
DISK_CACHE_PRUNE_MIN_FILE_AGE_MS=60000
DISK_CACHE_PRUNE_MAX_DELETE_PER_RUN=5000


# -----------------------------------------------------------------------------
# 4-1) Docker /app/data 쓰기 권한
# -----------------------------------------------------------------------------
# 컨테이너는 보안상 비-root UID 1000으로 실행합니다.
# v557부터 primary GID는 0(root group)입니다. root 권한으로 실행하는 것이 아니라,
# 일부 LXC/SMB/NFS bind mount가 root:root + group-write로 들어오는 경우도 처리하기 위한 설정입니다.
# /app/data는 docker compose에서 ./data:/app/data 로 bind mount됩니다.
# 지원되는 권한 형태는 둘 중 하나입니다.
#   A) 1000:1000 owner-write: chown -R 1000:1000 ./data && chmod -R u+rwX,g+rwX ./data
#   B) 0:0 group-write:     chgrp -R 0 ./data && chmod -R g+rwX ./data
#
# 최초 실행 전 권장:
#   mkdir -p ./data/user-data
#   sh tools/fix_docker_data_permissions.sh
#
# v548부터 compose의 /app/data bind mount는 create_host_path:false입니다.
# ./data가 없으면 Docker가 root:root 디렉터리를 자동 생성하지 않고 시작에 실패합니다.
#
# unprivileged LXC나 SMB/CIFS/NFS에서는 컨테이너 내부 chown/setgroups가 제한될 수 있으므로
# 앱 데이터(./data)는 가능하면 LXC 로컬 디스크에 두고, 소설 라이브러리만 외부 마운트로 두는 구성을 권장합니다.

# -----------------------------------------------------------------------------
# 5) 배포 모드
# -----------------------------------------------------------------------------
# direct: Node/컨테이너를 내부망에서 직접 접속.
# trusted-proxy: Nginx Proxy Manager 등 신뢰 가능한 reverse proxy 뒤에서 HTTPS 제공.
# cloudflare-tunnel: Cloudflare Tunnel이 앱으로 직접 전달.
DEPLOYMENT_MODE=direct

# cloudflare-tunnel에서 NPM이 X-Forwarded-Proto를 http로 덮어써도 Cloudflare가 전달한 CF-Visitor {\"scheme\":\"https\"}는 production HTTPS 판정에 사용됩니다.
#
# 보안 전제: Cloudflare Tunnel 모드에서 CF-Visitor를 신뢰하려면 WAN/외부 인터넷에서 origin으로 직접 들어오는 우회 경로가 없어야 합니다.
# 막아야 하는 대상은 NPM 관리자 포트(보통 81)만이 아니라 NPM service entry(80/443)와 Node 앱 포트(예: 3000) 전체입니다.
# 안전한 경로: 외부 사용자 -> Cloudflare -> cloudflared outbound tunnel -> 내부 NPM/Node.
# 위험한 경로: 외부 사용자 -> 공유기 포트포워딩/WAN -> NPM 80/443 또는 Node 포트. 이 경로가 열려 있으면 CF-Visitor/CF-Connecting-IP 헤더를 위조할 수 있습니다.
# 공유기/방화벽/Proxmox/LXC에서 80,443,81,3000 등 origin 포트가 WAN에 직접 노출되지 않는지 확인하세요.
# trusted-proxy/cloudflare-tunnel에서 실제 클라이언트 IP 헤더를 명시해야 할 때만 사용합니다.
# 예: X-Forwarded-For, CF-Connecting-IP
CLIENT_IP_HEADER=

# 서버 bind 주소입니다.
# Cloudflare Tunnel 단독 구성은 127.0.0.1 권장.
# Docker/NPM 프록시 구성은 비워두거나 0.0.0.0을 사용합니다.
HOST=

# -----------------------------------------------------------------------------
# 6) 구성 예시
# -----------------------------------------------------------------------------
# 내부망 HTTP direct 예시:
# NODE_ENV=
# DEPLOYMENT_MODE=direct
# URL=http://192.168.1.100:3000
# APP_ORIGIN=http://192.168.1.100:3000
# HOST=0.0.0.0

# HTTPS reverse proxy 예시:
# NODE_ENV=production
# DEPLOYMENT_MODE=trusted-proxy
# URL=https://reader.example.com
# APP_ORIGIN=https://reader.example.com
# HOST=0.0.0.0
# reverse proxy는 X-Forwarded-Proto: https 를 전달해야 합니다.

# Cloudflare Tunnel 예시:
# NODE_ENV=production
# DEPLOYMENT_MODE=cloudflare-tunnel
# URL=https://reader.example.com
# APP_ORIGIN=https://reader.example.com
# HOST=127.0.0.1
# CLIENT_IP_HEADER=CF-Connecting-IP
#
# Cloudflare Tunnel + 내부 NPM 예시:
# - Cloudflare Tunnel public hostname: reader.example.com -> http://NPM_내부IP:80
# - NPM proxy host: reader.example.com -> http://Node앱_내부IP:3000
# - 공유기 포트포워딩: 80/443/81/3000 없음
# - NPM 80/443/81과 Node 3000은 LAN 또는 tunnel 경유에서만 접근 가능

# Healthcheck 경로: /healthz

# -----------------------------------------------------------------------------
# 7) 세션 저장 / 대용량 파일 제한
# -----------------------------------------------------------------------------
# v530 이후 sessions.json에는 session/CSRF token 원문을 저장하지 않고 HMAC만 저장합니다.
# 운영에서는 재시작 후 세션을 유지하려면 충분히 긴 무작위 값을 설정하세요.
# 비워두면 production에서 런타임 임시 secret을 생성하며, 서버 재시작 시 기존 로그인 세션은 무효화됩니다.
SESSION_STORE_SECRET=change_this_to_a_long_random_secret_32_chars_or_more

# 단일 TXT 파일의 최대 허용 크기(bytes)입니다. 기본값은 100MiB입니다.
# 한도를 초과하면 content/block-manifest API가 413 text_file_too_large를 반환합니다.
MAX_TEXT_FILE_BYTES=104857600

# contentService 메모리 파일 캐시 한도입니다. 전체 검색은 chunk별 content 요청을 수행하므로,
# 50MiB 이상 TXT를 안정적으로 검색하려면 MAX_TEXT_FILE_BYTES보다 충분히 크게 잡아야 합니다.
# 기본값은 max(128MiB, MAX_TEXT_FILE_BYTES + 32MiB)입니다.
CONTENT_FILE_CACHE_MAX_BYTES=134217728
CONTENT_FILE_CACHE_MAX_ENTRIES=16

# TXT 읽기/인코딩 판별/전처리/chunk index 생성은 worker_threads 풀에서 처리합니다.
# 1이면 서버의 무거운 content 작업이 Node 메인 이벤트 루프를 덜 막고 여러 코어에 분산됩니다.
# CONTENT_WORKER_POOL_SIZE=0은 자동값입니다. 보통 min(4, CPU 코어-1)로 동작합니다.
CONTENT_WORKER_THREADS_ENABLED=1
CONTENT_WORKER_POOL_SIZE=0

# TXT 파일 인코딩 자동 판별입니다. 기본값은 auto입니다.
# UTF-8/UTF-16 BOM, UTF-8 유효성, jschardet 기반 감지, 후보 인코딩 점수화를 순서대로 사용합니다.
# 자동 감지가 틀리는 특정 라이브러리가 있으면 TEXT_FILE_ENCODING에 강제 인코딩을 지정하세요.
# 예: utf8, utf16-le, cp949, euc-kr, shift_jis, cp932, gb18030, big5, windows-1251, windows-1252, tis-620
TEXT_FILE_ENCODING=auto

# 자동 판별 후보를 직접 제한할 때만 사용합니다. 비워두면 다국어 기본 후보를 사용합니다.
# 예: cp949,utf8,shift_jis,gb18030,big5,windows-1251,windows-1252
TEXT_FILE_ENCODING_CANDIDATES=

# jschardet 감지 신뢰도 하한입니다. 0.6 기본값을 권장합니다.
TEXT_FILE_CHARDET_MIN_CONFIDENCE=0.6

# 검색 성능 프로파일입니다. auto는 서버의 가용 코어/cgroup 제한/메모리를 감지해 자동 선택합니다.
# 값: auto, safe, balanced, n100_2core, fast, aggressive
# N100 2코어 LXC처럼 제한된 환경은 보통 auto -> n100_2core로 잡히며,
# 고성능 로컬 SSD 서버는 auto -> fast/aggressive 쪽으로 완화됩니다.
SEARCH_PERFORMANCE_PROFILE=auto

# 라이브러리 저장소 특성입니다. auto/local/network/slow 중 선택합니다.
# SMB/CIFS/NFS처럼 네트워크 파일시스템이면 network 또는 slow로 두면 검색 동시성을 보수적으로 제한합니다.
SEARCH_STORAGE_PROFILE=auto

# 자동 감지가 틀릴 때만 사용합니다. 0이면 자동입니다.
SEARCH_SERVER_CORES=0
SEARCH_FULL_CONCURRENCY_MAX=0
SEARCH_LIVE_CONCURRENCY_MAX=0
SEARCH_MULTI_EPISODE_CONCURRENCY_MAX=0
SEARCH_CACHE_ONLY_CONCURRENCY=0
SEARCH_WORKER_BATCH_MAX=0

# 다중파일 folder block manifest는 기본적으로 현재 화 기준 앞뒤 N개 화만 생성합니다.
# 기본값 10이면 현재 화 포함 최대 21개 파일만 처리하므로, 대형 폴더 최초 복원 시 CPU/IO 급등을 줄입니다.
# seam 안정성을 우선하면 10, 대형 폴더 부하 절감을 더 우선하면 5로 낮추세요.
FOLDER_BLOCK_MANIFEST_RADIUS=5

# -----------------------------------------------------------------------------
# 8) Docker /app/data 권한
# -----------------------------------------------------------------------------
# 컨테이너는 UID 1000, primary GID 0으로 직접 실행됩니다.
# unprivileged Proxmox LXC에서는 su-exec/gosu 기반 권한 전환이 setgroups(2)에서
# 막힐 수 있으므로 컨테이너 내부 자동 chown/drop-privilege를 사용하지 않습니다.
# ./data는 1000:1000 owner-write 또는 0:0 group-write 중 하나면 됩니다.
APP_UID=1000
APP_GID=1000
APP_RUNTIME_GID=0
