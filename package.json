    "smoke:quick": "node tools/run_smoke_tests.js --quick",
    "smoke:full": "node tools/run_smoke_tests.js --full",
    "smoke:docs": "node tools/run_smoke_tests.js --docs",
    "smoke:cache": "node tools/run_smoke_tests.js --cache",
    "smoke:security": "node tools/run_smoke_tests.js --security",
    "smoke:reader": "node tools/run_smoke_tests.js --reader",
    "smoke:search": "node tools/run_smoke_tests.js --search",
    "smoke:settings": "node tools/run_smoke_tests.js --settings",
    "smoke:frontend": "node tools/run_smoke_tests.js --frontend",
    "verify": "node tools/run_smoke_tests.js --standard",
    "verify:full": "node tools/run_smoke_tests.js --full",
    "release:verify": "node tools/release_verify.js",
