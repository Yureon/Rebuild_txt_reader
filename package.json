{
  "name": "txt-reader-multi",
  "version": "1.0.0",
  "dependencies": {
    "express": "^4.18.2",
    "iconv-lite": "^0.6.3",
    "jschardet": "^3.1.4"
  },
  "scripts": {
    "check:frontend": "node tools/check_frontend_supervisor.js",
    "build:frontend-esm": "node tools/check_frontend_supervisor.js",
    "check:server": "node tools/check_server_structure.js",
    "check": "npm run check:frontend && npm run check:server",
    "smoke:server": "node tools/run_smoke_tests.js --server",
    "docs:scaffold": "node tools/rebuild_doc_scaffold.js",
    "package:rebuild": "node tools/package_rebuild.js",
    "docs:release-notes": "node tools/release_notes_from_package.js",
    "library:reorganize": "node tools/reorganize_library_files.js",
